{
  "name": "clippers-live-hub",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted short-form video clipping studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis --x64",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.clipperslivehub.studio",
    "productName": "Clippers Live Hub",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Clippers-Live-Hub-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}